# Copy this file to backend/.env and fill in your key. backend/.env is git-ignored.
# Create a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: use a different Claude model (default: claude-opus-5-5)
# PRELEGAL_CLAUDE_MODEL=claude-opus-5-5

# Optional: where accounts and documents are stored (default: backend/data/prelegal.db)
# PRELEGAL_DATABASE_URL=sqlite:///path/to/prelegal.db

# Set to true when serving over HTTPS, so the login cookie is only sent securely.
# PRELEGAL_SECURE_COOKIES=true
